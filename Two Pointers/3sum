## bruteforce -- TLE; TC: O(n^3)+O(n)=O(n^3); SC=O(n) cause of set

class Solution(object):
    def threeSum(self, nums):
        """
        :type nums: List[int]
        :rtype: List[List[int]]
        """
        res=[]
        seen=set()
        for i in range(len(nums)):
            for j in range(i+1,len(nums)):
                for k in range(j+1,len(nums)):
                    if nums[i]+nums[j]+nums[k]==0:
                        triplet= tuple(sorted([nums[i],nums[j],nums[k]]))  # I converted into tuple to make it hashable or you can just add as plain triplets and convert them into list during return.
                        if triplet not in seen:
                            seen.add(triplet)
                            res.append(triplet)
        return res




## sort + hashset + two pointers. TC: O(n)*O(n)=O(n^2); SC=O(n)

class Solution(object):
    def threeSum(self, nums):
        """
        :type nums: List[int]
        :rtype: List[List[int]]
        """
        nums.sort()
        res=set()
        for i in range(len(nums)):
            if nums[i]>0:
                break
            l,r=i+1,len(nums)-1
            x=0-nums[i]
            while l<r:
                if nums[l]+nums[r]==x:
                    res.add((nums[i],nums[l],nums[r]))
                    l,r=l+1,r-1
                elif nums[l]+nums[r]>x:
                    r-=1
                else:
                    l+=1
        return [list(tri) for tri in res]




## sort + 2 pointers. TC=O(n^2)
class Solution(object):
    def threeSum(self, nums):
        """
        :type nums: List[int]
        :rtype: List[List[int]]
        """
        nums.sort()
        res=[]
        for i in range(len(nums)):
            if nums[i]>0:
                break
            if i!=0 and nums[i]==nums[i-1]: 
                continue
            l,r=i+1,len(nums)-1
            x=0-nums[i]
            while l<r:
                if nums[l]+nums[r]==x:
                    res.append([nums[i],nums[l],nums[r]])
                    l,r=l+1,r-1
                    while l<r and nums[l]==nums[l-1]:
                        l+=1
                    while l<r and nums[r]==nums[r+1]:
                        r-=1
                elif nums[l]+nums[r]>x:
                    r-=1
                else:
                    l+=1
        return res
