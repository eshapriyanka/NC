## bruteforce -- TLE. TC=O(n^2)
In this approach, the problem is finding the max in left and right sizes which is taking O(N) times. In the next approach, I will optimize it to O(1).
class Solution(object):
    def trap(self, height):
        """
        :type height: List[int]
        :rtype: int
        """
        if len(height)<=2:
            return 0
        totwater=0
        for i in range(len(height)):
            if i==0 and height[i]==0:
                continue
            left=max(height[0:i]) if i>0 else 0
            right=max(height[i+1:]) if i < len(height)-1 else 0
            waterlevel=min(left,right)
            if waterlevel-height[i]>0:
                totwater += waterlevel-height[i]
        return totwater


## Prefix array (max for left) and suffix array (max for right) arrays. TC=O(N); SC=O(N) due to arrays
In this approach, we use 2 arrays storing max elements from front and back
class Solution(object):
    def trap(self, height):
        """
        :type height: List[int]
        :rtype: int
        """
        n=len(height)
        if n<=2:
            return 0
        left_max=[0]*n #prefix max
        right_max=[0]*n #suffix max

        left_max[0]=height[0]
        for i in range(1,n):
            left_max[i]=max(height[i],left_max[i-1])

        right_max[n-1]=height[n-1]
        for i in range(n-2,-1,-1):
            right_max[i]=max(height[i],right_max[i+1])

        totwater=0
        for i in range(1,n):
            # if i==0 and height[i]==0:
                # continue
            waterlevel=min(left_max[i],right_max[i])
            if waterlevel-height[i]>0:
                totwater += waterlevel-height[i]
        return totwater


## two pointers. TC: O(N), SC: O(1)
class Solution(object):
    def trap(self, height):
        """
        :type height: List[int]
        :rtype: int
        """
        n=len(height)
        leftmax=height[0]
        rightmax=height[n-1]

        totwater=0
        l,r=1,n-2

        while l<=r:
            if leftmax<=rightmax:
                if leftmax>height[l]:
                    totwater+=(leftmax-height[l])
                else:
                    leftmax=height[l]
                l+=1
            else:
                if rightmax>height[r]:
                    totwater+=(rightmax-height[r])
                else:
                    rightmax=height[r]
                r-=1
        return totwater
